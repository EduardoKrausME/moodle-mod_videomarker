<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/videomarker/db" VERSION="20260920" COMMENT="XMLDB file for Moodle mod_videomarker"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
    <TABLES>
        <TABLE NAME="videomarker" COMMENT="Video Marker activity instances">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="intro" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="videosource" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="url" SEQUENCE="false"/>
                <FIELD NAME="videourl" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="resumeplayback" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
                <FIELD NAME="allowseek" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
                <FIELD NAME="maxplaybackrate" TYPE="number" LENGTH="5" NOTNULL="true" DEFAULT="2" DECIMALS="2"
                       SEQUENCE="false"/>
                <FIELD NAME="disabledownload" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="completionpercent" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="80" SEQUENCE="false"/>
                <FIELD NAME="completionmarkers" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
                <FIELD NAME="grade" TYPE="number" LENGTH="10" NOTNULL="true" DEFAULT="100" DECIMALS="5"
                       SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
            </KEYS>
        </TABLE>
        <TABLE NAME="videomarker_questions" COMMENT="Questions that ask students to mark moments or intervals">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="videomarkerid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="questiontext" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="questiontextformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
                <FIELD NAME="questiontype" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="point" SEQUENCE="false"/>
                <FIELD NAME="points" TYPE="number" LENGTH="10" NOTNULL="true" DEFAULT="1" DECIMALS="5"
                       SEQUENCE="false"/>
                <FIELD NAME="required" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
                <FIELD NAME="allowretry" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
                <FIELD NAME="showfeedback" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
                <FIELD NAME="tolerance" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="3" SEQUENCE="false"/>
                <FIELD NAME="feedbackcorrect" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="feedbackincorrect" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="videomarker" TYPE="foreign" FIELDS="videomarkerid" REFTABLE="videomarker" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="activity-sort" UNIQUE="false" FIELDS="videomarkerid, sortorder"/>
            </INDEXES>
        </TABLE>
        <TABLE NAME="videomarker_targets" COMMENT="Expected target windows or intervals for each question">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="questionid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="targetindex" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="starttime" TYPE="number" LENGTH="12" NOTNULL="true" DEFAULT="0" DECIMALS="3"
                       SEQUENCE="false"/>
                <FIELD NAME="endtime" TYPE="number" LENGTH="12" NOTNULL="true" DEFAULT="0" DECIMALS="3"
                       SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="question" TYPE="foreign" FIELDS="questionid" REFTABLE="videomarker_questions"
                     REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="question-target" UNIQUE="true" FIELDS="questionid, targetindex"/>
            </INDEXES>
        </TABLE>
        <TABLE NAME="videomarker_attempts" COMMENT="Submitted attempts for marker questions">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="videomarkerid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="questionid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="attemptno" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
                <FIELD NAME="score" TYPE="number" LENGTH="10" NOTNULL="true" DEFAULT="0" DECIMALS="5" SEQUENCE="false"/>
                <FIELD NAME="maxscore" TYPE="number" LENGTH="10" NOTNULL="true" DEFAULT="0" DECIMALS="5"
                       SEQUENCE="false"/>
                <FIELD NAME="correctcount" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="markcount" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="avgdistance" TYPE="number" LENGTH="12" NOTNULL="true" DEFAULT="0" DECIMALS="3"
                       SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="activity" TYPE="foreign" FIELDS="videomarkerid" REFTABLE="videomarker" REFFIELDS="id"/>
                <KEY NAME="question" TYPE="foreign" FIELDS="questionid" REFTABLE="videomarker_questions"
                     REFFIELDS="id"/>
                <KEY NAME="user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="question-user-attempt" UNIQUE="true" FIELDS="questionid, userid, attemptno"/>
                <INDEX NAME="activity-user" UNIQUE="false" FIELDS="videomarkerid, userid"/>
            </INDEXES>
        </TABLE>
        <TABLE NAME="videomarker_marks" COMMENT="Individual point or interval marks in an attempt">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="attemptid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="markerindex" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="starttime" TYPE="number" LENGTH="12" NOTNULL="true" DEFAULT="0" DECIMALS="3"
                       SEQUENCE="false"/>
                <FIELD NAME="endtime" TYPE="number" LENGTH="12" NOTNULL="false" DECIMALS="3" SEQUENCE="false"/>
                <FIELD NAME="targetid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="expectedstart" TYPE="number" LENGTH="12" NOTNULL="true" DEFAULT="0" DECIMALS="3"
                       SEQUENCE="false"/>
                <FIELD NAME="expectedend" TYPE="number" LENGTH="12" NOTNULL="true" DEFAULT="0" DECIMALS="3"
                       SEQUENCE="false"/>
                <FIELD NAME="iscorrect" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="distance" TYPE="number" LENGTH="12" NOTNULL="true" DEFAULT="0" DECIMALS="3"
                       SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="attempt" TYPE="foreign" FIELDS="attemptid" REFTABLE="videomarker_attempts" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="attempt-marker" UNIQUE="true" FIELDS="attemptid, markerindex"/>
                <INDEX NAME="target" UNIQUE="false" FIELDS="targetid"/>
            </INDEXES>
        </TABLE>
        <TABLE NAME="videomarker_progress" COMMENT="Real watched video ranges and resume position per student">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="videomarkerid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="duration" TYPE="number" LENGTH="12" NOTNULL="true" DEFAULT="0" DECIMALS="3"
                       SEQUENCE="false"/>
                <FIELD NAME="watchedranges" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="watchedseconds" TYPE="number" LENGTH="12" NOTNULL="true" DEFAULT="0" DECIMALS="3"
                       SEQUENCE="false"/>
                <FIELD NAME="percent" TYPE="number" LENGTH="5" NOTNULL="true" DEFAULT="0" DECIMALS="2"
                       SEQUENCE="false"/>
                <FIELD NAME="lastposition" TYPE="number" LENGTH="12" NOTNULL="true" DEFAULT="0" DECIMALS="3"
                       SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="activity" TYPE="foreign" FIELDS="videomarkerid" REFTABLE="videomarker" REFFIELDS="id"/>
                <KEY NAME="user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="activity-user" UNIQUE="true" FIELDS="videomarkerid, userid"/>
            </INDEXES>
        </TABLE>
    </TABLES>
</XMLDB>
